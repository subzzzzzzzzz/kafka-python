# Confluent Cloud Kafka
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
CONFLUENT_TOPIC=aviation-reviews
CONFLUENT_API_KEY=your-api-key
CONFLUENT_API_SECRET=your-api-secret
CONFLUENT_SECURITY_PROTOCOL=SASL_SSL
CONFLUENT_SASL_MECHANISM=PLAIN
CONFLUENT_CLIENT_ID=aviation-databricks-pipeline

# Databricks output location
AVIATION_DBFS_BASE=dbfs:/FileStore/aviation-pipeline

# Structured Streaming option
KAFKA_STARTING_OFFSETS=earliest
