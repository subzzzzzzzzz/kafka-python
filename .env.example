# Local Kafka settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=aviation-reviews
KAFKA_GROUP_ID=aviation-review-local-consumer

# Local streaming behavior
PRODUCER_DELAY_SECONDS=1.0
PRODUCER_RETRIES=3
PRODUCER_RETRY_BACKOFF_SECONDS=0.5
CONSUMER_POLL_TIMEOUT_MS=1000
LOW_RATING_THRESHOLD=5.0
